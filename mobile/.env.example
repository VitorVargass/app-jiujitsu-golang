# Expo Go / navegador local na mesma rede: descobre o computador que executa Expo.
# A API continua na porta 8080. O túnel do Expo não publica a API.
EXPO_PUBLIC_API_URL=auto
# Também é possível usar uma URL explícita:
# Emulador Android: http://10.0.2.2:8080
# Celular: http://IP_DO_COMPUTADOR:8080
# APK / export de produção: use a URL explícita da API, preferencialmente HTTPS.
# EXPO_PUBLIC_PORTAL_URL=https://SEU_PORTAL
