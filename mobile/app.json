{
  "expo": {
    "name": "TatameMix",
    "slug": "tatame-jiujitsu",
    "scheme": "tatame",
    "version": "1.1.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.tatamemix.app",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F0F10"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o TatameMix leia o QR Code do aluno.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withShortAndroidPaths"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0F0F10",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "59590655-b390-411d-879d-6a2ac72b86ab"
      }
    }
  }
}
