{
  "expo": {
    "name": "TatameMix",
    "slug": "tatame-jiujitsu",
    "scheme": "tatame",
    "version": "1.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.tatame.jiujitsu",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F0F10"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o TatameMix leia o QR Code do aluno.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withShortAndroidPaths"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0F0F10"
  }
}
