DATABASE_URL=postgres://tatame:tatame_dev@localhost:5432/tatame?sslmode=disable
HTTP_ADDR=:8080
# Na hospedagem, deixe HTTP_ADDR ausente para usar automaticamente PORT fornecida pelo serviço.
ALLOWED_ORIGINS=auto
# Caminho do JSON privado por academia; vazio mantém Pix desabilitado.
ASAAS_CONNECTIONS_FILE=
# Export web do Expo; ../mobile/dist é detectado quando a variável não está definida.
WEB_DIST_DIR=../mobile/dist
# Copie para backend/.env. A API carrega esse arquivo quando iniciada em backend.
# Variáveis já definidas no terminal têm prioridade.
# auto libera apenas as origens web locais do Expo; em produção, liste as URLs do portal.

# InfinitePay: configure uma vez no servidor, nunca em EXPO_PUBLIC_*.
# Chave base64 de 32 bytes. Gere com um gerenciador seguro; guarde backup fora do banco.
PAYMENTS_MASTER_KEY=
PAYMENTS_PUBLIC_URL=
# Libere somente depois de validar a integracao e autorizar um teste controlado.
INFINITEPAY_ENABLED=false
